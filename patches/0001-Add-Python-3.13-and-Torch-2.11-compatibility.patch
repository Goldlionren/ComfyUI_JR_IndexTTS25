+def _write_pcm16_wav(output_path, wav, sampling_rate):
+    """Write channel-first waveform data without TorchCodec/FFmpeg coupling."""
+    wav_data = wav.detach().to(device="cpu", dtype=torch.int16).numpy().T
+    sf.write(output_path, wav_data, sampling_rate, subtype="PCM_16", format="WAV")
