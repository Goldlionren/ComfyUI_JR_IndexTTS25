+            elif lang.lower() in ['ja', 'es', 'ar']:
                 text = nemo_text_normalize(text, lang.lower())
             print(f'text after normalization: {text}')
 
@@ -791,7 +791,7 @@ class IndexTTS2:
                         emo_vec=emovec,
