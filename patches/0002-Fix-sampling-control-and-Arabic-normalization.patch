diff --git a/indextts/infer_v2_5.py b/indextts/infer_v2_5.py
index 0454cd9..447f74f 100644
--- a/indextts/infer_v2_5.py
+++ b/indextts/infer_v2_5.py
@@ -714,7 +714,7 @@ class IndexTTS2:
         if text_normalization:
             if lang.lower() in ['zh', 'zhen', 'en']:
                 text = self.text_process.normalize(text)
